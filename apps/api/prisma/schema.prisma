// Esquema Prisma de Localiator.
// Los modelos de dominio (Usuario, Producto, Lote, Pedido, etc.) se añaden en la Fase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles que SÍ se persisten en BD. Ojo con la asimetría: `packages/shared`
// define además `guest`, pero `guest` no es una fila — es la ausencia de un
// usuario autenticado. Por eso aquí solo existen BUYER y ADMIN.
enum Role {
  BUYER
  ADMIN
}

model User {
  id String @id @default(cuid()) // cuid: no revela el volumen de usuarios (a diferencia de un autoincremental) y es ordenable.

  email           String    @unique
  emailVerifiedAt DateTime? // null = email aún no verificado.
  passwordHash    String? // nullable: un usuario de Google puede no tener contraseña local.
  role            Role      @default(BUYER)

  // Datos personales del comprador. Se piden en el registro local para poder
  // FACTURAR con el IVA correcto (dirección de facturación) e identificar/contactar
  // al cliente. Todos NULLABLE en BD a propósito: las cuentas ya existentes y las
  // creadas por Google (que no pasan por este formulario) no los tienen. La
  // obligatoriedad real se valida en RegisterDto; aquí el nullable evita romper
  // esos casos y deja completar el perfil más adelante (p. ej. antes del checkout).
  // RGPD: son datos personales → se limpian al ejercer el derecho al olvido
  // (ver UsersService.anonymizeOwnAccount).
  firstName String?
  lastName  String?
  birthDate DateTime? @db.Date // solo fecha (sin hora ni zona); se valida ≥18 años.
  phone     String? // opcional (lo pidió Adrián como no obligatorio).

  // NIF/NIE/CIF del comprador. OPCIONAL: una venta al por menor a un particular se
  // documenta con factura SIMPLIFICADA, que no exige identificar al destinatario.
  // Solo hace falta cuando el cliente pide factura completa (típicamente autónomo o
  // empresa que quiere deducirse el gasto). Si está, se emite completa.
  // RGPD: dato personal → se limpia al ejercer el derecho al olvido.
  taxId String?

  // Dirección de FACTURACIÓN (no de envío: la recogida es en el almacén). Se
  // guarda desglosada en campos para poder validar y componer la factura.
  addressLine1 String? // calle y número.
  addressLine2 String? // piso, puerta, etc. (opcional).
  postalCode   String?
  city         String? // localidad.
  province     String?
  country      String? @default("ES") // ISO-3166 alpha-2; por defecto España.

  // Derecho al olvido (RGPD, Fase 4 tarea 02): no se puede borrar la fila de un
  // usuario con facturas (deber de conservación fiscal), así que se ANONIMIZA:
  // email/contraseña se sustituyen por valores neutros y se marca aquí la fecha.
  // Un valor no nulo significa "cuenta anonimizada": no puede volver a iniciar
  // sesión y sus facturas se conservan.
  anonymizedAt DateTime?

  // Ban automático por impago de una subasta ganada (Fase 5, tarea 07). Flag
  // global simple para el MVP: un usuario baneado no puede volver a pujar (lo
  // comprueba placeBid con BidRejectReason.BANNED). `bannedAt`/`banReason` son la
  // propia traza de auditoría de la acción (cuándo y por qué); no hay desban por
  // ahora. Si en el futuro hiciera falta granularidad (histórico, desbanes), se
  // migra a una tabla de bans.
  bannedAt  DateTime?
  banReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  orders             Order[]
  bids               Bid[]
  wonAuctions        Auction[]
  // Subastas en las que este usuario va ganando AHORA MISMO (estado del proxy).
  // Relación nombrada porque ya hay otra entre User y Auction (la del ganador).
  ledAuctions        Auction[] @relation("AuctionLeader")
}

// Sesión persistente (patrón decidido en CLAUDE.md): el access token (JWT corto)
// vive en memoria en el cliente; este refresh token (opaco, de vida larga) viaja
// en una cookie HttpOnly y se guarda AQUÍ para poder revocarlo.
//
// ¿Por qué opaco en BD y no un JWT autocontenido? Porque un JWT no se puede
// invalidar antes de que caduque; guardarlo en BD permite logout real, ban y
// detección de reutilización (rotación). Igual que los otros tokens, guardamos
// SOLO el hash.
model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique // SHA-256 del token opaco.

  // Rotación: al usar un refresh se revoca y se emite otro. Si más tarde llega un
  // token ya revocado, es señal de robo → se corta toda la cadena de sesión.
  revokedAt         DateTime?
  replacedByTokenId String? // id del token que lo sustituyó (traza de la rotación).

  expiresAt DateTime // sliding expiration (~15 días); se renueva en cada rotación (tarea 10).

  // Metadatos opcionales para auditoría de sesiones.
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Vincula una identidad de un proveedor externo (Google, y en el futuro otros) a
// un User local. Tabla genérica en vez de columnas googleId/githubId en User: así
// añadir un proveedor no toca el modelo User ni requiere una migración disruptiva
// (deja la puerta abierta como pide CLAUDE.md).
//
// La unicidad (provider, providerAccountId) garantiza que una misma cuenta de
// Google no se vincule a dos usuarios distintos.
model OAuthAccount {
  id String @id @default(cuid())

  provider          String // "google" (minúscula, estable).
  providerAccountId String // el `sub` de Google: id único e inmutable del usuario.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Tokens de un solo uso para verificación de email (06) y, más adelante,
// recuperación de contraseña (11). Una sola tabla con `type` en vez de una por
// caso: evita duplicar la mecánica (generar → hashear → validar → invalidar).
//
// SEGURIDAD: guardamos SOLO el hash del token (tokenHash), nunca el token en
// claro, igual que una contraseña. Si se filtra la BD, los tokens no son usables
// porque el enlace lleva el token original y aquí solo vive su hash.
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      VerificationTokenType
  tokenHash String                @unique // SHA-256 del token; se busca por aquí.

  expiresAt DateTime // caducidad corta (email 2 días, reset 1 h).
  usedAt    DateTime? // un solo uso: al verificar se marca y ya no vale.

  createdAt DateTime @default(now())

  @@index([userId, type])
}

// Producto individual y Lote son entidades SEPARADAS e independientes: comparten
// forma (mismos atributos) pero NO hay relación de contención (un lote no contiene
// productos). Se duplica el esquema a propósito para que puedan diverger en el
// futuro sin una migración dolorosa.

// Base de la búsqueda y el filtrado del catálogo. `parentId` es una auto-relación
// opcional: deja la puerta abierta a subcategorías con coste casi nulo, pero si al
// final las categorías son planas, queda siempre null y no estorba.
model Category {
  id String @id @default(cuid())

  name String
  slug String @unique // URLs amigables y SEO (ver Fase 5).

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]
  lots     Lot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())

  name        String
  description String

  // Dinero en céntimos (Int), nunca Float: la aritmética con enteros evita los
  // errores de coma flotante al operar con euros.
  priceCents    Int
  discountCents Int @default(0)

  stock Int @default(0)

  // URLs de las fotos. La subida real es Fase 3; de momento un array escalar basta.
  photos String[]

  // Obligatoria: todo producto debe ser filtrable por categoría desde el alta.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Lot {
  id String @id @default(cuid())

  name        String
  description String

  priceCents    Int
  discountCents Int @default(0)

  stock Int @default(0)

  photos String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// Auditoría de cambios sensibles (precio y stock), exigida por CLAUDE.md. No es
// histórico de precios como funcionalidad de negocio (descartado) — es una traza
// de quién cambió qué y cuándo.
enum AuditEntity {
  PRODUCT
  LOT
}

enum AuditField {
  PRICE
  STOCK
  DISCOUNT
}

// Tabla genérica en vez de una por entidad/atributo: más flexible a cambio de
// perder integridad referencial fuerte en entityId (no es FK real, solo un id
// lógico de Product o Lot según entityType).
//
// IMPORTANTE (Fase 3): la inserción de un AuditLog debe hacerse en la MISMA
// transacción Prisma que el cambio de precio/stock que registra, para que
// ambos se confirmen o fallen juntos (atomicidad).
model AuditLog {
  id String @id @default(cuid())

  // Nullable: sobrevive al borrado del usuario (derecho al olvido RGPD) y permite
  // cambios hechos por procesos automáticos sin actor humano.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  entityType AuditEntity
  entityId   String

  field    AuditField
  oldValue Int?
  newValue Int?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Pedidos (Fase 3). Flujo de RECOGIDA EN ALMACÉN (sin envíos, ver CLAUDE.md):
// el pedido se paga y luego se prepara y se recoge físicamente; no hay tracking
// ni transportista.
// ---------------------------------------------------------------------------

// Máquina de estados del pedido. El orden refleja el ciclo de vida real:
//   PENDING  → recién creado, con stock reservado, esperando el pago (tarea 03).
//   PAID     → el webhook de Stripe confirmó el cobro; stock ya descontado (06).
//   READY_FOR_PICKUP → el admin lo preparó en el almacén (tarea 11).
//   PICKED_UP → entregado al cliente en el almacén (tarea 11).
//   CANCELLED → reserva expirada/pago fallido, o cancelación de admin (07/11).
//   REFUNDED  → el dinero se devolvió ENTERO al cliente (reembolso total desde el
//               panel de Stripe, o disputa perdida). Terminal.
//   DISPUTED  → el cliente abrió un chargeback en su banco; Stripe retiene el
//               importe hasta resolverlo. Terminal en la práctica: lo resuelve el
//               webhook (a REFUNDED si se pierde, o al estado previo si se gana).
// Las transiciones legales se validan en el servicio (tarea 11), no aquí. OJO:
// REFUNDED y DISPUTED los pone SOLO el webhook de Stripe, nunca el admin a mano:
// el estado del dinero lo dicta Stripe, y ponerlo desde el backoffice sería una
// mentira que no se corresponde con ningún movimiento real.
enum OrderStatus {
  PENDING
  PAID
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
  REFUNDED
  DISPUTED
}

// Producto y Lote son entidades SEPARADAS (CLAUDE.md), sin una FK común. Una
// línea de pedido apunta a una u otra con este discriminador + `itemId`, en vez
// de dos FKs medio vacías. La contrapartida: Prisma no fuerza la integridad de
// `itemId`; se valida en el servicio al crear el pedido.
enum OrderItemType {
  PRODUCT
  LOT
}

model Order {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status OrderStatus @default(PENDING)

  // Total en céntimos (Int), como el resto del dinero del proyecto: lo fija el
  // servidor releyendo el precio de BD, nunca el cliente (seguridad, tarea 03).
  totalCents Int
  currency   String @default("eur")

  // Enlace fuerte con el cobro de Stripe. @unique hace de clave de idempotencia
  // del webhook (tarea 06: un mismo PaymentIntent no confirma el pedido dos
  // veces) y de base para la conciliación (tarea 08). Nullable porque el pedido
  // nace antes de crear el intent de pago (tarea 04).
  stripePaymentIntentId String? @unique

  paidAt DateTime? // se rellena al confirmar el cobro (tarea 06).

  // --- Reembolsos y disputas (chargebacks) ---
  // Importe devuelto al cliente, en céntimos. Campo propio y no solo un estado
  // porque los reembolsos PARCIALES existen (devolver un artículo de tres): en ese
  // caso el pedido sigue PAID y solo cambia esta cifra. El estado pasa a REFUNDED
  // únicamente cuando lo devuelto iguala al total.
  refundedCents Int       @default(0)
  refundedAt    DateTime? // fecha del último reembolso registrado.

  // Cuándo se abrió el chargeback. Se conserva aunque la disputa se gane y el
  // pedido vuelva a PAID: es el rastro de que este cliente disputó una vez.
  disputedAt DateTime?
  // Estado del pedido ANTES de la disputa, para poder restaurarlo si se gana. Sin
  // esto, ganar una disputa sobre un pedido ya entregado lo devolvería a PAID y se
  // volvería a pedir al almacén algo que el cliente ya se llevó.
  preDisputeStatus OrderStatus?

  // Origen SUBASTA (tarea 09): si el pedido nace de ganar una subasta, apunta a
  // ella. Nullable: los pedidos de venta directa no la tienen. NO es @unique a
  // propósito: en la segunda oportunidad (tarea 07) se crea un pedido nuevo para el
  // MISMO auctionId (el del moroso queda CANCELLED). Marca el origen para la
  // conciliación y permite saltarse la reserva de stock en el cobro (el ganador ya
  // es el único con derecho al artículo; no pasa por carrito).
  auctionId String?
  auction   Auction? @relation(fields: [auctionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines        OrderLine[]
  reservations StockReservation[]
  // Varias: la original más una rectificativa por cada reembolso registrado.
  invoices     Invoice[]

  @@index([userId])
  @@index([status])
  @@index([auctionId])
}

// Copia DESNORMALIZADA (snapshot) del artículo en el momento de la compra. Se
// guarda el nombre y el precio de entonces porque el producto puede editarse o
// borrarse después y el pedido debe seguir siendo fiel a lo que se compró.
// Referenciar solo `itemId` dejaría pedidos "rotos" al cambiar el catálogo.
model OrderLine {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemType OrderItemType
  itemId   String // id lógico del Product/Lot (no es FK real; ver enum).

  nameSnapshot   String // nombre del artículo cuando se compró.
  unitPriceCents Int // precio unitario aplicado (con descuento ya incluido).
  quantity       Int
  lineTotalCents Int // unitPriceCents * quantity, materializado para el histórico.

  @@index([orderId])
}

// Reserva temporal de stock durante el checkout. Es lo que impide vender dos
// veces el mismo artículo mientras un cliente paga (tarea 03). El stock real de
// Product/Lot NO se descuenta aquí: el "disponible" se calcula como
// stock − reservas vivas, así una reserva que expira o un pago fallido liberan
// stock sin tener que "devolverlo" (tareas 03/06/07). El barrido de expiradas
// vive en la tarea 07.
model StockReservation {
  id String @id @default(cuid())

  itemType OrderItemType
  itemId   String
  quantity Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  expiresAt DateTime // now + N min al crear la reserva (tarea 03).
  createdAt DateTime @default(now())

  @@index([itemType, itemId])
  @@index([expiresAt])
  @@index([orderId])
}

// Factura de un pedido pagado (tarea 09). Se genera automáticamente al confirmar
// el cobro (webhook, tarea 06). Los precios del catálogo son IVA INCLUIDO, así que
// el desglose va "hacia atrás": grossCents = total del pedido; netCents = base
// imponible; vatCents = grossCents − netCents.
// Tipo de documento. La ley distingue tres cosas que aquí conviven en una tabla:
//   FULL        → factura completa (art. 6 RD 1619/2012): exige identificar al
//                 destinatario con nombre, NIF y domicilio.
//   SIMPLIFIED  → factura simplificada (art. 4): el "ticket". Permitida en venta
//                 al por menor por debajo del umbral legal y sin datos del
//                 destinatario. Es lo que se emite si el cliente no dio NIF.
//   CORRECTIVE  → factura RECTIFICATIVA (art. 15), que corrige una anterior. Va en
//                 SERIE PROPIA y correlativa, obligatoriamente separada.
enum InvoiceType {
  FULL
  SIMPLIFIED
  CORRECTIVE
}

// Régimen de IVA con el que se emitió el documento. Se guarda POR FACTURA y no se
// lee de configuración al renderizar: si el negocio cambia de régimen, las
// facturas ya emitidas deben seguir mostrando el que se les aplicó.
//   REBU    → régimen especial de bienes usados (arts. 135-139 LIVA), el de este
//             negocio: se revenden artículos de segunda mano comprados en lotes.
//             El IVA se liquida sobre el MARGEN, no sobre el precio de venta, y la
//             factura NO puede desglosar la cuota repercutida: solo el total, con
//             la mención obligatoria del régimen. Que el cliente no vea IVA no es
//             un olvido: es el requisito.
//   GENERAL → régimen general, con base imponible y cuota desglosadas.
enum InvoiceRegime {
  REBU
  GENERAL
}

model Invoice {
  id String @id @default(cuid())

  // SIN @unique: un pedido puede acumular varios documentos (la factura original
  // más una rectificativa por cada reembolso). La regla "una sola factura original
  // por pedido" la impone InvoicingService dentro de su transacción.
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  type   InvoiceType   @default(SIMPLIFIED)
  regime InvoiceRegime @default(REBU)

  // Serie legal correlativa sin huecos. Las rectificativas van en serie SEPARADA
  // (prefijo "R"), como exige el art. 15: "2026-000123" frente a "R2026-000004".
  number   String   @unique
  series   String // "" para la serie ordinaria, "R" para rectificativas.
  issuedAt DateTime @default(now())

  // Dinero en céntimos (Int), como el resto del proyecto. En una rectificativa los
  // importes son NEGATIVOS: representan la corrección, no el nuevo total.
  grossCents Int

  // Desglose de IVA. NULLABLE porque bajo REBU no existe cuota repercutida que
  // mostrar: son null y la plantilla no imprime desglose. Solo se rellenan en
  // régimen general. vatRateBps = tipo en puntos básicos (2100 = 21 %).
  netCents   Int?
  vatRateBps Int?
  vatCents   Int?

  // --- Snapshot fiscal ---
  // La factura es un documento INMUTABLE con deber de conservación, así que copia
  // los datos en el momento de emitirse en vez de leerlos por relación. Dos razones
  // concretas, ambas reales en este proyecto:
  //  1. El derecho al olvido (RGPD) vacía nombre y dirección del User. Sin este
  //     snapshot, ejercerlo destruía datos que la factura debe conservar.
  //  2. El emisor sale de .env: cambiar una variable reescribía retroactivamente
  //     todas las facturas ya emitidas.
  issuerName    String
  issuerTaxId   String
  issuerAddress String

  customerEmail   String
  customerName    String? // null en una simplificada (no exige destinatario).
  customerTaxId   String? // NIF/NIE/CIF; obligatorio en la factura completa.
  customerAddress String? // domicilio compuesto en una línea.

  // --- Rectificativas (art. 15 RD 1619/2012) ---
  // Documento al que rectifica y motivo. Ambos obligatorios en la rectificativa, y
  // el motivo debe constar impreso en el documento.
  correctsInvoiceId String?
  corrects          Invoice?  @relation("Rectificacion", fields: [correctsInvoiceId], references: [id])
  corrections       Invoice[] @relation("Rectificacion")
  correctionReason  String?

  // Líneas: la descripción de las operaciones es obligatoria en TODOS los formatos,
  // incluida la simplificada. Se copian de OrderLine al emitir, por lo mismo que el
  // resto del snapshot.
  lines InvoiceLine[]

  createdAt DateTime @default(now())

  @@index([orderId])
}

// Línea de factura: copia congelada de la OrderLine en el momento de emitir.
model InvoiceLine {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String // descripción del bien entregado (art. 6.1.f).
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([invoiceId])
}

// Contador correlativo de facturas por año. Fila por año; el número se incrementa
// de forma atómica (INSERT ... ON CONFLICT DO UPDATE ... RETURNING) para que dos
// facturas simultáneas no se salten ni repitan número (sin huecos, requisito
// legal). Tabla propia en vez de contar filas de Invoice: evita carreras.
model InvoiceCounter {
  // Clave compuesta año + serie: la serie ordinaria y la de rectificativas llevan
  // numeraciones INDEPENDIENTES, cada una correlativa y sin huecos.
  year   Int
  series String // "" ordinaria, "R" rectificativas.

  lastNumber Int @default(0)

  @@id([year, series])
}

// ---------------------------------------------------------------------------
// Subastas propias (Fase 5). Una subasta pone a pujar UN artículo (producto o
// lote) del catálogo durante una ventana de tiempo. El cobro del ganador
// (tarea 09) reutiliza el flujo de pedidos/Stripe de la Fase 3: una subasta
// ganada acaba siendo un Order normal, indistinguible de una venta directa.
// ---------------------------------------------------------------------------

// Ciclo de vida de la subasta. El orden refleja el flujo real:
//   SCHEDULED → creada, aún no ha llegado su `startsAt`.
//   LIVE      → abierta, admite pujas entre `startsAt` y `endsAt` (tarea 02).
//   CLOSED    → venció `endsAt`; ganador fijado o desierta (tarea 06).
//   PAID      → el ganador pagó por el flujo Stripe existente (tarea 09).
//   CANCELLED → cancelada, o desierta sin más pujadores tras impago (tarea 07).
// Las transiciones legales se validan en el servicio, no aquí (como OrderStatus).
enum AuctionStatus {
  SCHEDULED
  LIVE
  CLOSED
  PAID
  CANCELLED
}

// El artículo subastado es un Product o un Lot, entidades SEPARADAS sin FK común
// (CLAUDE.md). Se reutiliza `OrderItemType` como discriminador en vez de crear un
// enum propio: los valores son los mismos (PRODUCT/LOT) y significan lo mismo.
// Como en OrderLine, `itemId` NO es una FK real; se valida en el servicio.
model Auction {
  id String @id @default(cuid())

  itemType OrderItemType
  itemId   String // id lógico del Product/Lot (no es FK real; ver enum).

  // Dinero en céntimos (Int), como todo el dinero del proyecto. Precio de salida
  // y salto mínimo entre pujas; el incremento es fijo por subasta (tarea 02).
  startingPriceCents Int
  minIncrementCents  Int

  startsAt DateTime
  // Columna normal MUTABLE (no calculada): el antisniping (tarea 05) la mueve a
  // `now + 3 min` ante pujas de último segundo, y el cierre (tarea 06) la relee.
  endsAt   DateTime

  status AuctionStatus @default(SCHEDULED)

  // --- Estado de la puja proxy (puja automática por máximo) ---
  //
  // Estas tres columnas son la FUENTE DE VERDAD del precio y de quién va ganando.
  // Antes se derivaban de las filas Bid (`ORDER BY amountCents DESC LIMIT 1`), pero
  // con puja proxy eso deja de valer: el líder no es quien tiene el importe visible
  // más alto, sino quien tiene el MÁXIMO más alto, y el precio efectivo depende de
  // los dos máximos más altos a la vez.
  //
  // Se desnormaliza aquí, y no en una consulta sobre Bid, porque esta fila YA se
  // bloquea con SELECT ... FOR UPDATE en cada puja: el estado del proxy queda
  // protegido por el mismo lock que ya serializaba las pujas, sin añadir ningún
  // mecanismo de concurrencia nuevo. Además permite resolver el empate de máximos
  // con una regla explícita ("a un empate no se destrona al líder") en lugar de
  // depender de la resolución en milisegundos de `createdAt`.
  //
  // Las escribe UN SOLO SITIO: AuctionsService.placeBid, dentro del lock.

  // Precio efectivo actual (lo que pagaría hoy el líder). null = aún sin pujas.
  currentPriceCents Int?

  // Quién va ganando ahora mismo. null = aún sin pujas.
  leaderUserId String?
  leader       User?   @relation("AuctionLeader", fields: [leaderUserId], references: [id])

  // Techo del líder: lo máximo que su proxy llegará a pujar por él.
  //
  // PRIVADO. No se emite JAMÁS por el canal en vivo ni aparece en el historial de
  // pujas: quien lo conociera podría ganar la subasta por un céntimo. Se trata con
  // el mismo cuidado que los datos personales enmascarados (ver auctions.mask.ts).
  leaderMaxCents Int?

  // Ganador DESNORMALIZADO: se fija al cerrar (tarea 06) para no recalcular la
  // puja máxima en cada lectura ni en el cobro (tarea 09) / impago (tarea 07).
  // `winningBidId` es @unique: una puja no puede ganar dos subastas.
  winnerUserId String?
  winner       User?   @relation(fields: [winnerUserId], references: [id])
  winningBidId String? @unique

  // Plazo de pago del ganador actual (tarea 07). Se fija al cerrar con ganador
  // (tarea 06) y se REINICIA en cada segunda oportunidad. Un job busca subastas
  // CLOSED con este plazo vencido y sin pago (aún CLOSED, no PAID): banea al
  // moroso y ofrece la subasta al siguiente pujador. Nullable: desierta o aún LIVE.
  paymentDueAt DateTime?

  // Aviso "a punto de cerrar" (tarea 08): marca el instante en que se avisó a los
  // pujadores de que quedaba poco. Guard para no reavisar (una vez por cuenta
  // atrás). El antisniping (tarea 05) lo REINICIA a null al extender `endsAt`, para
  // poder volver a avisar cuando la subasta se acerque de nuevo a su nuevo cierre.
  endingSoonNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids Bid[]

  // Pedidos nacidos de esta subasta (tarea 09). Normalmente uno (el del ganador);
  // pueden ser varios en el tiempo si hubo impago + segunda oportunidad (tarea 07):
  // el del moroso queda CANCELLED y se crea otro para el nuevo ganador.
  orders Order[]

  @@index([status])
  // Filtro por estado + rango de `endsAt` con ORDER BY endsAt: es exactamente la
  // consulta del calendario público y del listado paginado. El orden de las
  // columnas importa: `status` va primero porque se filtra por igualdad (IN) y
  // `endsAt` después porque es el rango y el criterio de orden.
  @@index([status, endsAt])
  @@index([itemType, itemId])
}

// Una puja de un usuario sobre una subasta. Las pujas son INMUTABLES: el
// "historial de pujas" son todas las filas Bid de una subasta ordenadas por
// `createdAt`, sin necesidad de una tabla de historial aparte. La regla de
// negocio (superar la máxima + incremento) vive en el servicio (tarea 02) y su
// blindaje de concurrencia en la tarea 04.
model Bid {
  id String @id @default(cuid())

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Importe EFECTIVO de esta puja: el precio al que quedó la subasta en ese
  // instante. Es el dato público (va al historial y al canal en vivo).
  amountCents Int

  // Techo del pujador en el momento de pujar: hasta dónde autorizó a su proxy a
  // llegar. En una puja sin proxy coincide con `amountCents`.
  //
  // PRIVADO, igual que Auction.leaderMaxCents: nunca sale por el canal en vivo.
  // Se guarda por puja (y no solo el vigente en Auction) porque la segunda
  // oportunidad por impago (tarea 07) necesita saber cuál era el SEGUNDO máximo
  // más alto para ofrecerle la subasta al siguiente de la fila.
  maxAmountCents Int

  // true si la generó el proxy subiendo automáticamente por el usuario, en vez de
  // una acción humana. Se usa para pintar el historial ("puja automática") y para
  // NO disparar el antisniping: solo una puja humana debe extender el cierre, o una
  // guerra de proxies lo extendería dos veces por cada puja recibida.
  isAutomatic Boolean @default(false)

  createdAt DateTime @default(now())

  // Índice compuesto para leer la puja máxima de una subasta rápido
  // (ORDER BY amountCents DESC LIMIT 1).
  @@index([auctionId, amountCents])
}
